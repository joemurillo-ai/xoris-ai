{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-v05/types/**/*.ts",
    ".next-v05/dev/types/**/*.ts",
    ".next-v06/types/**/*.ts",
    ".next-v06/dev/types/**/*.ts",
    ".next-v08/types/**/*.ts",
    ".next-v08/dev/types/**/*.ts",
    ".next-v09/types/**/*.ts",
    ".next-v09/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
